# Copy to .env (never commit .env). Every variable is optional.

# --- API service (src/jobx/serve) ---
# Backend: gguf (llama-cpp-python, default) or regex (rule-based, no model).
JOBX_BACKEND=gguf
# A local GGUF file, e.g. the released jobx-qwen2.5-0.5b-Q4_K_M.gguf (GitHub Release model-v1) ...
JOBX_GGUF_PATH=
# ... or a Hugging Face repo + file pattern.
JOBX_GGUF_REPO=
JOBX_GGUF_FILE=*Q4_K_M.gguf
# Prompt: compact (the CPU fine-tune's training prompt) or full (base models / GPU route).
JOBX_PROMPT=compact
# Limits.
JOBX_MAX_CHARS=8000
JOBX_MAX_BATCH=16
JOBX_MAX_BATCH_CHARS=64000
JOBX_RATE_LIMIT_PER_MIN=60
JOBX_MAX_RETRIES=2
JOBX_MAX_TOKENS=384
# Field-confidence calibrator (fitted on the validation split by `jobx calibrate`) and an optional
# abstention threshold that overrides the calibrated one.
JOBX_CALIBRATOR=results/calibration/calibrator.json
JOBX_ABSTAIN_THRESHOLD=
JOBX_LOG_LEVEL=INFO

# --- API baselines (GitHub Actions secrets in this repo; locally only if you run them) ---
GROQ_API_KEY=
